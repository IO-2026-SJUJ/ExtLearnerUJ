# Skopiuj ten plik jako .env i uzupełnij właściwymi wartościami.
# Plik .env NIE może być commitowany do repozytorium.

# Django
DJANGO_SECRET_KEY=wygeneruj-wlasny-klucz-np-przez-get_random_secret_key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Cookie — w produkcji ustaw SECURE_COOKIES=True (tylko HTTPS)
SECURE_COOKIES=False

# Email — realne wysyłanie maili (kody weryfikacyjne, reset hasła).
# Bez EMAIL_HOST: maile drukują się w konsoli serwera (dev — widać kod).
# Z EMAIL_HOST: SMTP. Przykład dla Gmaila (hasło aplikacji, nie zwykłe!):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=twoj.adres@gmail.com
# EMAIL_HOST_PASSWORD=haslo-aplikacji-16-znakow
# DEFAULT_FROM_EMAIL=twoj.adres@gmail.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@extlearner.uj.edu.pl

# Baza — w Sprincie 1 SQLite wystarcza.
# Od Sprintu 2 planowany Postgres (Supabase, region EU — wymóg RODO O-01).
DATABASE_URL=sqlite:///db.sqlite3


# Domeny produkcyjne dla formularzy POST przez HTTPS (oddzielone przecinkiem):
# CSRF_TRUSTED_ORIGINS=https://olejnik.net,https://www.olejnik.net
CSRF_TRUSTED_ORIGINS=
